generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  FLEET_MANAGER
  DISPATCH_SUPERVISOR
}

enum CrewRole {
  DRIVER
  CONDUCTOR
}

enum SalaryType {
  DAILY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model BusVehicle {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  registrationNumber String   @unique
  routeName          String
  seatingCapacity    Int
  isActive           Boolean  @default(true)

  // Statutory document expiry dates (Sri Lanka)
  insuranceExpiry      DateTime?
  revenueLicenseExpiry DateTime?
  routePermitExpiry    DateTime?
  emissionTestExpiry   DateTime?
  fitnessCertExpiry    DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dailyRouteLogs        DailyRouteLog[]
  maintenanceLogs       BusMaintenanceLog[]
  crewAttendancePayroll CrewAttendancePayroll[]
  fleetExpenses         FleetExpense[]
  employees             Employee[]

  @@index([isActive])
}

model DailyRouteLog {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  date                DateTime
  busId               String   @db.ObjectId
  routeName           String
  morningCollection   Float
  eveningCollection   Float
  fuelCost            Float
  tollAndLineFees     Float
  conductorCommission Float
  driverCommission    Float
  kmRun               Float?
  fuelLiters          Float?
  otherExpenses       Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bus BusVehicle @relation(fields: [busId], references: [id], onDelete: Restrict)

  @@unique([busId, date])
  @@index([date])
}

model BusMaintenanceLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  busId       String   @db.ObjectId
  serviceType String
  cost        Float
  vendorName  String
  odometerKm      Float?
  nextServiceDate DateTime?
  notes           String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bus BusVehicle @relation(fields: [busId], references: [id], onDelete: Restrict)

  @@index([busId])
  @@index([date])
}

model Employee {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  role          CrewRole
  phone         String?
  nic           String?
  licenseNumber String?
  salaryType    SalaryType @default(DAILY)
  baseSalary    Float
  busId         String?    @db.ObjectId
  isActive      Boolean    @default(true)
  joinedDate    DateTime   @default(now())
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bus            BusVehicle?             @relation(fields: [busId], references: [id], onDelete: SetNull)
  attendances    CrewAttendancePayroll[]
  salaryPayments SalaryPayment[]

  @@index([isActive])
  @@index([busId])
}

model CrewAttendancePayroll {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  employeeId   String?          @db.ObjectId
  employeeName String
  role         CrewRole
  status       AttendanceStatus @default(PRESENT)
  dailyWage    Float
  advanceTaken Float            @default(0)
  balanceOwed  Float            @default(0)
  busId        String?          @db.ObjectId
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  bus      BusVehicle? @relation(fields: [busId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([busId])
  @@index([employeeId])
}

model SalaryPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId    String   @db.ObjectId
  employeeName  String
  paymentDate   DateTime
  periodMonth   String
  grossEarned   Float    @default(0)
  bonus         Float    @default(0)
  deductions    Float    @default(0)
  netPaid       Float
  paymentMethod String   @default("Cash")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([paymentDate])
  @@index([periodMonth])
}

model CrewRate {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  role              CrewRole @unique
  baseDailyWage     Float
  commissionPercent Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// General operating expenses not captured in daily logs / workshop
/// (insurance, revenue licence, permits, lease installments, tyres, parking, office, etc.)
model FleetExpense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  category    String
  description String
  amount      Float
  paidTo      String?
  busId       String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bus BusVehicle? @relation(fields: [busId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([busId])
  @@index([category])
}

/// Key/value application settings (commission rates, budgets)
model AppSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model DailyFleetSummary {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  date                 DateTime  @unique
  totalCollection      Float
  totalFuelExpense     Float
  totalTollAndLineFees Float
  totalMaintenanceCost Float
  totalCrewPay         Float
  netProfit            Float
  isSyncedWithHub      Boolean   @default(false)
  syncedAt             DateTime?
  lastSyncError        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
